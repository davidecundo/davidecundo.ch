---
import { site } from '../config/site';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('de');
const year = new Date().getFullYear();
---

{/* Quiet mono footer in the page column (rasmic.xyz). */}
<footer class="container-page mt-24 pb-10 font-mono text-meta text-muted">
  <div class="flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between">
    <p class="text-ink">{site.name} · {site.location}</p>
    <nav aria-label={t('footer.nav')}>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        <li>
          <a class="nav-link hover:text-ink" href={site.social.linkedin} rel="me noopener" target="_blank">
            LinkedIn<span class="sr-only"> {t('external.newTab')}</span>
          </a>
        </li>
        <li>
          <a class="nav-link hover:text-ink" href={site.social.x} rel="me noopener" target="_blank">
            X<span class="sr-only"> {t('external.newTab')}</span>
          </a>
        </li>
        <li><a class="nav-link hover:text-ink" href={`mailto:${site.email}`}>E-Mail</a></li>
        <li><a class="nav-link hover:text-ink" href="/impressum/">{t('footer.imprint')}</a></li>
        <li><a class="nav-link hover:text-ink" href="/datenschutz/">{t('footer.privacy')}</a></li>
      </ul>
    </nav>
  </div>
  <p class="mt-3 tabular-nums">&copy; {year}</p>
</footer>
