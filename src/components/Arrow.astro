---
/**
 * Decorative arrow (lucide arrow-down-right / arrow-up-right / arrow-right), always aria-hidden.
 * se = internal page (↘), ne = external (↗), e = inline link (→).
 * Slides a little when the surrounding `.group` is hovered.
 */
interface Props {
  dir?: 'se' | 'ne' | 'e';
  class?: string;
}

const { dir = 'se', class: className } = Astro.props;
const paths = {
  se: ['M7 7l10 10', 'M17 7v10H7'],
  ne: ['M7 17L17 7', 'M7 7h10v10'],
  e: ['M5 12h14', 'M12 5l7 7-7 7'],
};
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  width="16"
  height="16"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['arrow', `arrow-${dir}`, className]}
>
  {paths[dir].map((d) => <path d={d} />)}
</svg>
